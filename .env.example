# 新版豆包语音控制台 > API Key 管理
VOLCENGINE_SPEECH_API_KEY=replace_me

# 声音复刻 2.0 固定使用这个资源；公版 TTS 2.0 则为 seed-tts-2.0
VOLCENGINE_TTS_RESOURCE_ID=seed-icl-2.0
VOLCENGINE_TTS_WS_URL=wss://openspeech.bytedance.com/api/v3/tts/bidirection
VOLCENGINE_VOICE_CLONE_URL=https://openspeech.bytedance.com/api/v3/tts/voice_clone
VOLCENGINE_VOICE_QUERY_URL=https://openspeech.bytedance.com/api/v3/tts/get_voice

TTS_SAMPLE_RATE=24000
TTS_FORMAT=pcm
TTS_SPEECH_RATE=0
TTS_LOUDNESS_RATE=0
VOICE_PROFILE_DIR=data/profiles
METRICS_FILE=outputs/latency.jsonl
