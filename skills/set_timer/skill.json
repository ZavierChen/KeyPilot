{
  "schema_version": 1,
  "id": "set_timer",
  "name": "设置倒计时",
  "description": "创建一秒到一天的持久倒计时，到点后发声并弹出提醒。",
  "risk": "low",
  "confirmation": "never",
  "input_schema": {
    "type": "object",
    "properties": {
      "seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
      "label": {"type": "string"}
    },
    "required": ["seconds", "label"],
    "additionalProperties": false
  },
  "examples": [
    {"utterance": "倒计时二十分钟", "call": {"seconds": 1200, "label": "倒计时结束"}}
  ],
  "executor": "local.persistent_timer"
}
